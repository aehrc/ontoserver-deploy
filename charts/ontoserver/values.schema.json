{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ontoserver": {
      "type": "object",
      "properties": {
        "deployment": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Deployment",
                "StatefulSet"
              ]
            },
            "type": {
              "type": "string"
            },
            "image": {
              "type": "string"
            },
            "imagePullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "isReadOnly": {
              "type": "boolean"
            },
            "allowScaledReadWrite": {
              "type": "boolean"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0
            },
            "clusterName": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "labels": {
              "type": "object"
            },
            "podAnnotations": {
              "type": "object"
            },
            "podLabels": {
              "type": "object"
            },
            "podSecurityContext": {
              "type": "object",
              "description": "Pod-level securityContext, passed through as-is. Empty means unset."
            },
            "containerSecurityContext": {
              "type": "object",
              "description": "Container-level securityContext for the Ontoserver container, passed through as-is. Empty means unset."
            },
            "automountServiceAccountToken": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Mount the ServiceAccount token into the pod. Null leaves it to the cluster default."
            },
            "extraVolumes": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Extra pod volumes, rendered verbatim and appended after the chart's own volumes."
            },
            "extraVolumeMounts": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Extra volumeMounts for the Ontoserver container, rendered verbatim and appended after the chart's own mounts."
            },
            "deploymentStrategy": {
              "type": "string",
              "enum": [
                "RollingUpdate",
                "Recreate"
              ]
            },
            "startupProbe": {
              "type": "object",
              "properties": {
                "initialDelaySeconds": {
                  "type": "integer"
                },
                "periodSeconds": {
                  "type": "integer"
                },
                "failureThreshold": {
                  "type": "integer"
                },
                "timeoutSeconds": {
                  "type": "integer"
                }
              }
            },
            "livenessProbe": {
              "type": "object",
              "properties": {
                "initialDelaySeconds": {
                  "type": "integer"
                },
                "periodSeconds": {
                  "type": "integer"
                },
                "failureThreshold": {
                  "type": "integer"
                },
                "timeoutSeconds": {
                  "type": "integer"
                }
              }
            },
            "readinessProbe": {
              "type": "object",
              "properties": {
                "initialDelaySeconds": {
                  "type": "integer"
                },
                "periodSeconds": {
                  "type": "integer"
                },
                "failureThreshold": {
                  "type": "integer"
                },
                "timeoutSeconds": {
                  "type": "integer"
                }
              }
            },
            "persistence": {
              "type": "object",
              "properties": {
                "enabledForDeployment": {
                  "type": "boolean"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "shared",
                    "split"
                  ]
                },
                "files": {
                  "type": "object",
                  "properties": {
                    "accessMode": {
                      "type": "string",
                      "enum": [
                        "ReadWriteOnce",
                        "ReadWriteMany",
                        "ReadOnlyMany",
                        "ReadWriteOncePod"
                      ]
                    },
                    "storageSize": {
                      "type": "string"
                    },
                    "existingVolume": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    },
                    "pv": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "diskURI": {
                          "type": "string"
                        },
                        "csiDriver": {
                          "type": "string"
                        },
                        "storageClassName": {
                          "type": "string"
                        }
                      }
                    },
                    "storageClass": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "provided": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "boolean"
                            },
                            "storageProvisioner": {
                              "type": "string"
                            },
                            "reclaimPolicy": {
                              "type": "string"
                            },
                            "storageParameters": {
                              "type": "object"
                            },
                            "allowVolumeExpansion": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "dbfiles": {
                  "type": "object",
                  "properties": {
                    "accessMode": {
                      "type": "string",
                      "enum": [
                        "ReadWriteOnce",
                        "ReadWriteMany",
                        "ReadOnlyMany",
                        "ReadWriteOncePod"
                      ]
                    },
                    "storageSize": {
                      "type": "string"
                    },
                    "existingVolume": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    },
                    "pv": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "diskURI": {
                          "type": "string"
                        },
                        "csiDriver": {
                          "type": "string"
                        },
                        "storageClassName": {
                          "type": "string"
                        }
                      }
                    },
                    "storageClass": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "provided": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "boolean"
                            },
                            "storageProvisioner": {
                              "type": "string"
                            },
                            "reclaimPolicy": {
                              "type": "string"
                            },
                            "storageParameters": {
                              "type": "object"
                            },
                            "allowVolumeExpansion": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "podDisruptionBudget": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "minAvailable": {
                  "type": ["integer", "string", "null"]
                },
                "maxUnavailable": {
                  "type": ["integer", "string", "null"]
                },
                "unhealthyPodEvictionPolicy": {
                  "type": ["string", "null"],
                  "enum": [null, "", "IfHealthyBudget", "AlwaysAllow"]
                }
              }
            },
            "containerPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "lifecycle": {
              "type": "object"
            },
            "db": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "postgresVersion": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "containerSecurityContext": {
                  "type": "object",
                  "description": "Container-level securityContext for the Postgres sidecar, passed through as-is. Empty means unset."
                }
              }
            }
          },
          "required": [
            "kind",
            "type",
            "image",
            "isReadOnly"
          ]
        },
        "imageCredentials": {
          "type": "object",
          "properties": {
            "registry": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          }
        },
        "serverName": {
          "type": "string"
        },
        "serverPort": {
          "type": [
            "string",
            "integer"
          ]
        },
        "hostNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeZone": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "properties": {
            "ontoserver": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                },
                "initialHeapSize": {
                  "type": "string"
                },
                "maxHeapSize": {
                  "type": "string"
                }
              }
            },
            "db": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "healthCheckOption": {
          "type": "string",
          "enum": [
            "-s",
            "-f",
            "-p",
            "-l",
            "-L"
          ]
        },
        "certmanager": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clusterIssuerName": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            }
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "certRef": {
              "type": "string"
            }
          }
        },
        "gateway": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "listenerPortSecure": {
              "type": [
                "integer",
                "string"
              ]
            },
            "listenerPortPlain": {
              "type": [
                "integer",
                "string"
              ]
            },
            "allowPlaintext": {
              "type": "boolean"
            },
            "annotations": {
              "type": "object"
            },
            "infrastructureAnnotations": {
              "type": "object"
            },
            "className": {
              "type": "string"
            },
            "requestTimeout": {
              "type": "string",
              "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$",
              "description": "duration strings like '1h', '30m', '15s', '100ms', up to 4 segments"
            },
            "closureRequestTimeout": {
              "type": "string",
              "pattern": "^(([0-9]{1,5}(h|m|s|ms)){1,4})?$",
              "description": "Request timeout for the $closure HTTPRoute. Empty falls back to requestTimeout."
            },
            "backendServiceNameOverride": {
              "type": "string"
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "annotations": {
              "type": "object"
            },
            "className": {
              "type": "string"
            },
            "backendServiceNameOverride": {
              "type": "string"
            }
          }
        },
        "managementService": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Extra labels so a Prometheus with a non-empty serviceMonitorSelector can discover this ServiceMonitor."
                },
                "interval": {
                  "type": "string",
                  "pattern": "^(([0-9]+(y|w|d|h|m|s|ms))+)?$",
                  "description": "Scrape interval as a Prometheus duration. Empty uses the Prometheus global default."
                },
                "scrapeTimeout": {
                  "type": "string",
                  "pattern": "^(([0-9]+(y|w|d|h|m|s|ms))+)?$",
                  "description": "Scrape timeout as a Prometheus duration; must be less than interval. Empty uses the Prometheus default."
                },
                "namespaceSelector": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Namespaces to search for the management Service. Empty means the release namespace only."
                }
              }
            }
          }
        },
        "tests": {
          "type": "object",
          "properties": {
            "ttlSecondsAfterFinished": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "opentelemetry": {
          "type": "object",
          "properties": {
            "instrumentation": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "image": {
                  "type": "string"
                },
                "serviceName": {
                  "type": "string"
                },
                "propagators": {
                  "type": "string"
                },
                "excludedClasses": {
                  "type": "string"
                },
                "exporter": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "endpoint": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "customization": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "additionalProperties": {}
        },
        "secretConfig": {
          "type": "object",
          "additionalProperties": {}
        },
        "existingSecretConfig": {
          "type": "string",
          "description": "Name of a pre-existing Secret whose keys are injected as environment variables. Empty means unused."
        },
        "externalSecret": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "refreshInterval": {
              "type": "string"
            },
            "secretStoreRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              }
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "dataFrom": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "imagePullSecret": {
              "type": "object",
              "properties": {
                "secretStoreRef": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    }
                  }
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "username": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "property": {
                          "type": "string"
                        }
                      }
                    },
                    "password": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "property": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "deployment",
        "serverName",
        "hostNames"
      ]
    },
    "envoygateway": {
      "type": "object",
      "properties": {
        "controlPlaneNamespace": {
          "type": "string"
        },
        "createGatewayClass": {
          "type": "boolean"
        },
        "envoyProxy": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0
            },
            "pdbMinAvailable": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "accessLog": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "format": {
                  "type": "string"
                }
              }
            }
          }
        },
        "gatewayServiceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "clientTrafficPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "idleTimeout": {
              "type": "string"
            },
            "proxyProtocol": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "clientIPDetection": {
              "type": "object",
              "properties": {
                "xForwardedFor": {
                  "type": "object",
                  "properties": {
                    "numTrustedHops": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "backendTrafficPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "requestBufferLimit": {
              "type": "string"
            },
            "rateLimit": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "integer"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "Second",
                    "Minute",
                    "Hour"
                  ]
                }
              }
            },
            "rateLimitUserAgents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "securityPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "defaultAction": {
              "type": "string",
              "enum": [
                "Allow",
                "Deny"
              ]
            },
            "deniedCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "traefik": {
      "type": "object",
      "properties": {
        "ingressRoute": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "annotations": {
              "type": "object"
            },
            "entryPoints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "backendPort": {
              "type": [
                "integer",
                "string"
              ]
            },
            "backendScheme": {
              "type": "string"
            },
            "backendServiceNameOverride": {
              "type": "string"
            },
            "serversTransport": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "insecureSkipVerify": {
                  "type": "boolean"
                },
                "rootCAsSecrets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "certificatesSecrets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "nginx-ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "controller": {
          "type": "object",
          "properties": {
            "ingressClass": {
              "type": "object",
              "properties": {
                "create": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "ingressClassByName": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "required": [
    "ontoserver"
  ]
}
