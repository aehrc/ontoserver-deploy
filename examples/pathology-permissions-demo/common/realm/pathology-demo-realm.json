      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["https://ontoserver.csiro.au/*"],
      "webOrigins": ["https://ontoserver.csiro.au"],
