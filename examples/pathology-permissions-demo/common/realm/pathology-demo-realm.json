  "clients": [
    {
      "clientId": "authoring-server",
      "name": "Authoring Ontoserver",
      "description": "Resource server representing the authoring Ontoserver instance",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "production-server",
      "name": "Production Ontoserver",
      "description": "Resource server representing the production Ontoserver instance",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "atomio-server",
      "name": "Atomio Server",
      "description": "Resource server representing the Atomio syndication server",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "demo-cli",
      "name": "Demo CLI Client",
      "description": "Client for setup scripts and API demos using direct access grants",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "authoring-server",
        "production-server",
        "user-realm-roles-authorities",
        "openid",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "syndication-consumer",
      "name": "Syndication Consumer",
      "description": "Service account for downstream Ontoserver instances to authenticate when consuming syndication feeds from authoring. Granted PERM_READ (all communities) so it can access all community-labeled resources.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "syndication-consumer-secret",
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "authoring-server",
        "user-realm-roles-authorities",
        "openid"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "shrimp",
      "name": "Shrimp (Cloud-hosted)",
      "description": "Cloud-hosted Shrimp browser UI at ontoserver.csiro.au — used for the visual walkthrough and manual demos",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["https://ontoserver.csiro.au/*"],
      "webOrigins": ["https://ontoserver.csiro.au"],
      "attributes": {
        "exclude.issuer.from.auth.response": "true"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "authoring-server",
        "production-server",
        "user-realm-roles-authorities",
        "system/*.read",
        "system/*.write",
        "onto/synd.read",
        "onto/synd.write",
        "openid",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "user/*.read",
        "user/*.write",
        "launch",
        "fhirUser"
      ]
    },
    {
      "clientId": "snapper",
      "name": "Snapper (Cloud-hosted)",
