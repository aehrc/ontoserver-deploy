{
  "id": "pathology-demo",
  "realm": "pathology-demo",
  "displayName": "Pathology Terminology Demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      {
        "name": "PERM_READ",
        "description": "Wildcard read access to all community resources",
        "composite": false
      },
      {
        "name": "PERM_WRITE",
        "description": "Wildcard write access to all community resources",
        "composite": false
      },
      {
        "name": "Community creator",
        "description": "Can create new communities via Ontocloak admin UI",
        "composite": false
      },
      {
        "name": "Community owner",
        "description": "Base role for community ownership and group management",
        "composite": true,
        "composites": {
          "client": {
            "realm-management": [
              "query-groups",
              "query-users",
              "view-users"
            ],
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      },
      {
        "name": "All communities owner",
        "description": "Owner rights across all communities",
        "composite": true,
        "composites": {
          "realm": ["Community owner"]
        }
      },
      {
        "name": "All communities authors",
        "description": "Read and write access to all community resources",
        "composite": true,
        "composites": {
          "realm": ["PERM_READ", "PERM_WRITE"]
        }
      },
      {
        "name": "Community content administrator",
        "description": "Emergency read/write access to all FHIR resources regardless of labels",
        "composite": true,
        "composites": {
          "realm": ["PERM_READ", "PERM_WRITE"]
        }
      },
      {
        "name": "Consumer",
        "description": "Read-only access to authoring, production, and atomio FHIR endpoints",
        "composite": true,
        "composites": {
          "client": {
            "authoring-server": ["authoring-serverFHIR_READ"],
            "production-server": ["production-serverFHIR_READ"],
            "atomio-server": ["atomio-serverFHIR_READ"]
          }
        }
      },
      {
        "name": "Author",
        "description": "Read/write access to authoring FHIR, read access to production and atomio",
        "composite": true,
        "composites": {
          "client": {
            "authoring-server": ["authoring-serverFHIR_READ", "authoring-serverFHIR_WRITE"],
            "production-server": ["production-serverFHIR_READ"],
            "atomio-server": ["atomio-serverFHIR_READ", "atomio-serverFHIR_WRITE"]
          }
        }
      },
      {
        "name": "Approver",
        "description": "Author access plus syndication management for releasing content",
        "composite": true,
        "composites": {
          "realm": ["Author"],
          "client": {
            "authoring-server": ["authoring-serverSYND_READ", "authoring-serverSYND_WRITE"],
            "atomio-server": ["atomio-serverSYND_READ", "atomio-serverSYND_WRITE"]
          }
        }
      },
      {
        "name": "Full administrator",
        "description": "Full access to all endpoints and all communities",
        "composite": true,
        "composites": {
          "realm": [
            "All communities owner",
            "All communities authors",
            "Community creator",
            "Approver"
          ],
          "client": {
            "authoring-server": ["authoring-serverAPI_READ", "authoring-serverAPI_WRITE", "authoring-serverFHIR_READ", "authoring-serverFHIR_WRITE", "authoring-serverSYND_READ", "authoring-serverSYND_WRITE"],
            "production-server": ["production-serverAPI_READ", "production-serverAPI_WRITE", "production-serverFHIR_READ", "production-serverSYND_READ"],
            "atomio-server": ["atomio-serverFHIR_READ", "atomio-serverFHIR_WRITE", "atomio-serverSYND_READ", "atomio-serverSYND_WRITE"]
          }
        }
      },
      {
        "name": "offline_access",
        "description": "OpenID Connect built-in scope: offline_access",
        "composite": false
      },
      {
        "name": "uma_authorization",
        "description": "UMA authorization",
        "composite": false
      },
      {
        "name": "default-roles-pathology-demo",
        "description": "Default roles for the realm",
        "composite": true,
        "composites": {
          "realm": ["offline_access"],
          "client": {
            "account": ["view-profile", "manage-account"]
          }
        }
      }
    ],
    "client": {
      "authoring-server": [
        {
          "name": "authoring-serverFHIR_READ",
          "description": "Read access to the authoring FHIR endpoint (audience-prefixed for token scoping)"
        },
        {
          "name": "authoring-serverFHIR_WRITE",
          "description": "Write access to the authoring FHIR endpoint (audience-prefixed for token scoping)"
        },
        {
          "name": "authoring-serverAPI_READ",
          "description": "Read access to the authoring admin API (audience-prefixed for token scoping)"
        },
        {
          "name": "authoring-serverAPI_WRITE",
          "description": "Write access to the authoring admin API (audience-prefixed for token scoping)"
        },
        {
          "name": "authoring-serverSYND_READ",
          "description": "Read access to the authoring syndication endpoint (audience-prefixed for token scoping)"
        },
        {
          "name": "authoring-serverSYND_WRITE",
          "description": "Write access to the authoring syndication endpoint (audience-prefixed for token scoping)"
        }
      ],
      "production-server": [
        {
          "name": "production-serverFHIR_READ",
          "description": "Read access to the production FHIR endpoint (audience-prefixed for token scoping)"
        },
        {
          "name": "production-serverSYND_READ",
          "description": "Read access to the production syndication endpoint (audience-prefixed for token scoping)"
        },
        {
          "name": "production-serverAPI_READ",
          "description": "Read access to the production admin API (audience-prefixed for token scoping)"
        },
        {
          "name": "production-serverAPI_WRITE",
          "description": "Write access to the production admin API — includes triggering preload/syndication (audience-prefixed for token scoping)"
        }
      ],
      "atomio-server": [
        {
          "name": "atomio-serverFHIR_READ",
          "description": "Read access to the Atomio FHIR/feed endpoint (audience-prefixed for token scoping)"
        },
        {
          "name": "atomio-serverFHIR_WRITE",
          "description": "Write access to the Atomio FHIR/feed endpoint (audience-prefixed for token scoping)"
        },
        {
          "name": "atomio-serverSYND_READ",
          "description": "Read access to the Atomio syndication endpoint (audience-prefixed for token scoping)"
        },
        {
          "name": "atomio-serverSYND_WRITE",
          "description": "Write/publish access to the Atomio syndication endpoint (audience-prefixed for token scoping)"
        }
      ]
    }
  },

  "groups": [
